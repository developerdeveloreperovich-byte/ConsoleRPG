<UserControl x:Class="GameWPF.UI.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameWPF.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource CanvasGradientBrush}">
    <Grid Background="{StaticResource CanvasGradientBrush}">
        <Grid x:Name="ClassSelectionPanel" Margin="34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Name="GameTextControl" Content="Choose your class" Grid.Row="0" Grid.Column="1"
                   HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Margin="0,8,0,28"/>
            <Button Name="BackToMainMenu" Content="Back to main menu" Grid.Row="0" Grid.Column="2"
                    HorizontalAlignment="Right" Click="BackToMainMenuButtonClick"/>

            <Border Grid.Row="1" Grid.Column="0" Margin="10" Padding="18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Height="190" MaxWidth="250" Margin="8" Stretch="Uniform"
                           Source="pack://siteoforigin:,,,/Images/warrior.png"/>
                    <Label Name="WarriorInfo" Grid.Row="1" Content="" FontSize="16" Padding="14"
                           Background="{StaticResource RaisedPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1" HorizontalContentAlignment="Center"/>
                    <Button Name="ChooseWarrior" Grid.Row="2" Content="Choose warrior" Click="ChooseWarriorButtonClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Margin="10" Padding="18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Height="190" MaxWidth="250" Margin="8" Stretch="Uniform"
                           Source="pack://siteoforigin:,,,/Images/Archer.png"/>
                    <Label Name="ArcherInfo" Grid.Row="1" Content="" FontSize="16" Padding="14"
                           Background="{StaticResource RaisedPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1" HorizontalContentAlignment="Center"/>
                    <Button Name="ChooseArcher" Grid.Row="2" Content="Choose archer" Click="ChooseArcherButtonClick"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Margin="10" Padding="18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Height="190" MaxWidth="250" Margin="8" Stretch="Uniform"
                           Source="pack://siteoforigin:,,,/Images/Mage.png"/>
                    <Label Name="MageInfo" Grid.Row="1" Content="" FontSize="16" Padding="14"
                           Background="{StaticResource RaisedPanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1" HorizontalContentAlignment="Center"/>
                    <Button Name="ChooseMage" Grid.Row="2" Content="Choose mage" Click="ChooseMageButtonClick"/>
                </Grid>
            </Border>
        </Grid>

        <ContentControl x:Name="ActionContent"/>
    </Grid>
</UserControl>
